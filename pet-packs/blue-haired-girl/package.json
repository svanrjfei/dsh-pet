{
  "name": "dsh-pet-xiaotuantuan",
  "version": "0.1.21",
  "description": "小团团独立桌宠：透明待机动画，需先安装并启用 dsh-pet。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "pickup.js", "schedule.js", "client.js", "cordis.patch.yml", "pet"],
  "scripts": {
    "test": "node --test index.test.js pickup.test.js schedule.test.js",
    "prepack": "npm test"
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "inject": ["@deepseek-ai/dsh-client-connection"], "platform": "web" } },
  "dependencies": { "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1" },
  "devDependencies": { "@deepseek-ai/cordis": "~4.1.0" },
  "peerDependencies": { "dsh-pet": ">=0.4.7 <0.5.0" },
  "peerDependenciesMeta": { "dsh-pet": { "optional": true } },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svanrjfei/dsh-pet.git",
    "directory": "pet-packs/blue-haired-girl"
  },
  "license": "SEE LICENSE IN README.md"
}
